#| label: load-packages
library(readr)
library(dplyr)
library(tidyr)
library(forcats)   # working with categorical variables / factors
library(ggplot2)   # visualization
library(leaflet)   # interactive maps
library(DT)        # interactive tables
library(scales)    # scale functions for visualization
library(janitor)   # clean column names
library(viridis)   # colorblind-friendly color palettes
library(here)      # file paths relative to project root
#| label: load-data
# delta_visits_raw <- read_csv(
#   "https://portal.edirepository.org/nis/dataviewer?packageid=edi.587.1&entityid=d0dd56e44e3ab9f5ec60f787b46f5bf0",
#   show_col_types = FALSE
# )
delta_visits_raw <- read_csv(
here("data/r_data_visualization", "Socioecological_monitoring_data.csv")
)
#| label: explore-data
# What are the columns?
colnames(delta_visits_raw)
# Shape and data types — note that visitor counts are in separate columns
glimpse(delta_visits_raw)
# What time period does this data cover?
range(delta_visits_raw$Date)
# What times of day were surveys conducted?
unique(delta_visits_raw$Time_of_Day)
#| label: clean-names
delta_visits <- delta_visits_raw %>%
janitor::clean_names()
# Compare before and after
colnames(delta_visits)
View(delta_visits)
#| label: pivot-longer
visits_long <- delta_visits %>%
pivot_longer(
cols      = c(sm_boat, med_boat, lrg_boat,
bank_angler, scientist, cars),
names_to  = "visitor_type",
values_to = "quantity"
) %>%
rename(restore_loc = eco_restore_approximate_location) %>%
select(-notes)
# How did the shape change?
cat("Original: ", nrow(delta_visits), "rows ×", ncol(delta_visits), "cols\n")
cat("Long:     ", nrow(visits_long),  "rows ×", ncol(visits_long),  "cols\n")
head(visits_long)
#| label: three-options
# Option 1 — data and mapping in ggplot() [PREFERRED]
ggplot(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits)) +
geom_col()
#| label: exercise-1-daily-totals
daily_visits_loc <- visits_long %>%
group_by(restore_loc, date, visitor_type) %>%
summarise(daily_visits = sum(quantity), .groups = "drop")
head(daily_visits_loc)
#| label: three-options
# Option 1 — data and mapping in ggplot() [PREFERRED]
ggplot(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits)) +
geom_col()
# Option 2 — mapping called in geom
ggplot(data = daily_visits_loc) +
geom_col(aes(x = restore_loc, y = daily_visits))
# Option 3 — everything in geom
ggplot() +
geom_col(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits))
#| label: geom-boxplot
daily_visits_loc %>%
filter(
daily_visits < 30,
visitor_type %in% c("sm_boat", "med_boat", "lrg_boat")
) %>%
ggplot(aes(x = visitor_type, y = daily_visits)) +
geom_boxplot()
#| label: geom-violin
daily_visits_loc %>%
filter(
daily_visits < 30,
visitor_type %in% c("sm_boat", "med_boat", "lrg_boat")
) %>%
ggplot(aes(x = visitor_type, y = daily_visits)) +
geom_violin()
#| label: geom-line-point
daily_visits_loc %>%
filter(
restore_loc == "Decker Island",
visitor_type == "med_boat"
) %>%
ggplot(aes(x = date, y = daily_visits)) +
geom_line() +
geom_point()
head(oring)
p0 <- ggplot(data = oring, aes(x = Temperature, y = Damage))
p0
p1 <- p0 + geom_point()
p1
p2 <- p0 + geom_point(size = 2)
p2
p_fixed <- ggplot(oring, aes(x = Temperature, y = Damage)) +
geom_point(color = "steelblue", size = 3)
p_fixed
p_mapped <- ggplot(oring, aes(x = Temperature, y = Damage, color = factor(Blowby))) +
geom_point(size = 3)
p_mapped
p3 <- ggplot(oring, aes(x = Temperature, y = Damage)) +
geom_point(size = 2)
p3
p4 <- p3 + stat_smooth(method = "loess", se = FALSE)
p4
p5 <- ggplot(oring, aes(x = Temperature, y = jitter(Damage))) +
geom_point(size = 2) +
stat_smooth(method = "loess", se = FALSE)
p5
p6 <- ggplot(oring, aes(x = Temperature, y = Damage)) +
geom_point(size = 2) +
stat_smooth(method = "loess", se = FALSE) +
annotate(
"rect",
xmin = 26, xmax = 29,
ymin = 0, ymax = 12,
alpha = 0.2,
fill = "red"
)
p6
p7 <- p6 + annotate(
"text",
x = 31,
y = 3,
label = "Forecast\n26 to 29°F",
hjust = 0
)
p7
p8 <- p7 + labs(
title = "O-ring damage versus temperature",
subtitle = "Lower temperatures were associated with more damage",
x = "Temperature (°F)",
y = "Damage index",
caption = "Data: DAAG::orings with added damage index"
)
p8
#| label: load-packages
library(readr)
library(dplyr)
library(tidyr)
library(forcats)   # working with categorical variables / factors
library(ggplot2)   # visualization
library(leaflet)   # interactive maps
library(DT)        # interactive tables
library(scales)    # scale functions for visualization
library(janitor)   # clean column names
library(viridis)   # colorblind-friendly color palettes
library(here)      # file paths relative to project root
#| label: load-data
# delta_visits_raw <- read_csv(
#   "https://portal.edirepository.org/nis/dataviewer?packageid=edi.587.1&entityid=d0dd56e44e3ab9f5ec60f787b46f5bf0",
#   show_col_types = FALSE
# )
delta_visits_raw <- read_csv(
here("data/r_data_visualization", "Socioecological_monitoring_data.csv")
)
#| label: explore-data
# What are the columns?
colnames(delta_visits_raw)
#| label: clean-names
delta_visits <- delta_visits_raw %>%
janitor::clean_names()
# Compare before and after
colnames(delta_visits)
#| label: pivot-longer
visits_long <- delta_visits %>%
pivot_longer(
cols      = c(sm_boat, med_boat, lrg_boat,
bank_angler, scientist, cars),
names_to  = "visitor_type",
values_to = "quantity"
) %>%
rename(restore_loc = eco_restore_approximate_location) %>%
select(-notes)
# How did the shape change?
cat("Original: ", nrow(delta_visits), "rows ×", ncol(delta_visits), "cols\n")
cat("Long:     ", nrow(visits_long),  "rows ×", ncol(visits_long),  "cols\n")
head(visits_long)
#| label: exercise-1-daily-totals
daily_visits_loc <- visits_long %>%
group_by(restore_loc, date, visitor_type) %>%
summarise(daily_visits = sum(quantity), .groups = "drop")
head(daily_visits_loc)
#| label: three-options
# Option 1 — data and mapping in ggplot() [PREFERRED]
ggplot(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits)) +
geom_col()
# Option 2 — mapping called in geom
ggplot(data = daily_visits_loc) +
geom_col(aes(x = restore_loc, y = daily_visits))
# Option 3 — everything in geom
ggplot() +
geom_col(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits))
#| label: geom-boxplot
daily_visits_loc %>%
filter(
daily_visits < 30,
visitor_type %in% c("sm_boat", "med_boat", "lrg_boat")
) %>%
ggplot(aes(x = visitor_type, y = daily_visits)) +
geom_boxplot()
#| label: geom-violin
daily_visits_loc %>%
filter(
daily_visits < 30,
visitor_type %in% c("sm_boat", "med_boat", "lrg_boat")
) %>%
ggplot(aes(x = visitor_type, y = daily_visits)) +
geom_violin()
#| label: geom-line-point
daily_visits_loc %>%
filter(
restore_loc == "Decker Island",
visitor_type == "med_boat"
) %>%
ggplot(aes(x = date, y = daily_visits)) +
geom_line() +
geom_point()
#| label: aes-wrong-fill
# fill = "blue" INSIDE aes() — this does NOT make blue bars
ggplot(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits,
fill = "blue")) +
geom_col()
#| label: aes-correct-constant
# fill = "blue" OUTSIDE aes() — now all bars are actually blue
ggplot(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits)) +
geom_col(fill = "blue")
#| label: aes-correct-variable
# fill = visitor_type INSIDE aes() — correct because it IS a variable
ggplot(data = daily_visits_loc,
aes(x = restore_loc, y = daily_visits,
fill = visitor_type)) +
geom_col()
#| label: labs-and-theme
ggplot(data = daily_visits_loc,
aes(y = restore_loc, x = daily_visits,
fill = visitor_type)) +
geom_col() +
labs(
x        = "Number of Visits",
y        = "Restoration Location",
fill     = "Type of Visitor",
title    = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during July 2017 and March 2018"
) +
theme_bw()
#| label: themes-demo
# Build the base plot once so we can quickly swap themes
base_plot <- ggplot(data = daily_visits_loc,
aes(y = restore_loc, x = daily_visits,
fill = visitor_type)) +
geom_col() +
labs(x = "Number of Visits", y = "Restoration Location",
fill = "Type of Visitor",
title = "Total Visits to Delta Restoration Areas")
base_plot + theme_bw()       # white background, dark grid
base_plot + theme_minimal()  # no background panel
base_plot + theme_light()    # light gray grid
base_plot + theme_classic()  # no grid — publication classic
#| label: custom-theme
ggplot(data = daily_visits_loc,
aes(y = restore_loc, x = daily_visits,
fill = visitor_type)) +
geom_col() +
labs(
x     = "Number of Visits",
y     = "Restoration Location",
fill  = "Type of Visitor",
title = "Total Visits to Delta Restoration Areas by Visitor Type"
) +
theme_bw() +                         # built-in theme FIRST
theme(
legend.position = "bottom",        # move legend
axis.ticks.y    = element_blank()  # remove y-axis tick marks
)
#| label: my-theme
my_theme <- theme_bw(base_size = 16) +
theme(
legend.position = "bottom",
axis.ticks.y    = element_blank()
)
#| label: my-theme
my_theme <- theme_bw(base_size = 16) +
theme(
legend.position = "bottom",
axis.ticks.y    = element_blank()
)
#| label: plot-with-my-theme
ggplot(data = daily_visits_loc,
aes(y = restore_loc, x = daily_visits,
fill = visitor_type)) +
geom_col() +
labs(
x        = "Number of Visits",
y        = "Restoration Location",
fill     = "Type of Visitor",
title    = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during study period"
) +
my_theme
#| label: exercise-2-scale
# Step 1: Add axis breaks
ggplot(data = daily_visits_loc,
aes(y = restore_loc, x = daily_visits,
fill = visitor_type)) +
geom_col() +
labs(x = "Number of Visits", y = "Restoration Location",
fill = "Type of Visitor",
title = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during study period") +
scale_x_continuous(breaks = seq(0, 120, 20)) +
my_theme
# Step 2: Also remove the gap between bars and axis (expand)
ggplot(data = daily_visits_loc,
aes(y = restore_loc, x = daily_visits,
fill = visitor_type)) +
geom_col() +
labs(x = "Number of Visits", y = "Restoration Location",
fill = "Type of Visitor",
title = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during study period") +
scale_x_continuous(breaks = seq(0, 120, 20), expand = c(0, 0)) +
my_theme
#| label: fct-reorder-ascending
daily_visits_totals <- daily_visits_loc %>%
group_by(restore_loc) %>%
mutate(n = sum(daily_visits)) %>%
ungroup() %>%
mutate(restore_loc = fct_reorder(restore_loc, n))
# Confirm: no longer alphabetical
levels(daily_visits_totals$restore_loc)
#| label: plot-sorted-ascending
ggplot(data = daily_visits_totals,
aes(x = daily_visits, y = restore_loc,
fill = visitor_type)) +
geom_col() +
labs(x = "Number of Visits", y = "Restoration Location",
fill = "Type of Visitor",
title = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during study period") +
scale_x_continuous(breaks = seq(0, 120, 20), expand = c(0, 0)) +
my_theme
#| label: fct-reorder-descending
daily_visits_totals <- daily_visits_loc %>%
group_by(restore_loc) %>%
mutate(n = sum(daily_visits)) %>%
ungroup() %>%
mutate(restore_loc = fct_reorder(restore_loc, desc(n)))
ggplot(data = daily_visits_totals,
aes(x = daily_visits, y = restore_loc,
fill = visitor_type)) +
geom_col() +
labs(x = "Number of Visits", y = "Restoration Location",
fill = "Type of Visitor",
title = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during study period") +
scale_x_continuous(breaks = seq(0, 120, 20), expand = c(0, 0)) +
my_theme
#| label: viridis-color
ggplot(data = daily_visits_totals,
aes(x = daily_visits, y = restore_loc,
fill = visitor_type)) +
geom_col() +
scale_fill_viridis_d() +
labs(
x        = "Number of Visits",
y        = "Restoration Location",
fill     = "Type of Visitor",
title    = "Total Visits to Delta Restoration Areas by Visitor Type",
subtitle = "Sum of all visits during study period"
) +
scale_x_continuous(breaks = seq(0, 120, 20), expand = c(0, 0)) +
my_theme
#| label: ggsave-demo
#| eval: false
# Create the figures directory if it doesn't exist
dir.create("figures", showWarnings = FALSE)
# Save the last rendered plot
ggsave("figures/visit_restore_site_delta.jpg",
width = 12, height = 6, units = "in")
# Save a named object at publication resolution
ggsave("figures/visit_restore_site_delta.png",
plot   = last_plot(),
width  = 12,
height = 6,
units  = "in",
dpi    = 300)
#| label: facet-wrap-plot
#| fig-width: 12
#| fig-height: 8
facet_plot <- ggplot(data = daily_visits_totals,
aes(x = visitor_type, y = daily_visits,
fill = visitor_type)) +
geom_col() +
facet_wrap(
~restore_loc,
scales = "free_y",   # each panel gets its own y-axis scale
ncol   = 5,
nrow   = 2
) +
scale_fill_viridis_d() +
labs(
x        = "Type of Visitor",
y        = "Number of Visits",
title    = "Total Visits to Delta Restoration Areas",
subtitle = "Sum of all visits during study period"
) +
theme_bw() +
theme(
legend.position = "bottom",
axis.ticks.x    = element_blank(),
axis.text.x     = element_blank()   # legend handles labeling
)
facet_plot
#| label: locations-df
locations <- visits_long %>%
distinct(restore_loc, .keep_all = TRUE) %>%
select(restore_loc, latitude, longitude)
locations
#| label: dt-table
datatable(locations)
#| label: leaflet-basic
leaflet(locations) %>%
addTiles() %>%                   # OpenStreetMap base layer
addMarkers(
lng   = ~longitude,
lat   = ~latitude,
popup = ~restore_loc           # clickable label
)
#| label: leaflet-circle-markers
leaflet(locations) %>%
addTiles() %>%
addCircleMarkers(
lng         = ~longitude,
lat         = ~latitude,
popup       = ~restore_loc,
radius      = 5,
fillColor   = "salmon",
fillOpacity = 1,
stroke      = TRUE,
weight      = 0.5,
color       = "white",
opacity     = 1
)
